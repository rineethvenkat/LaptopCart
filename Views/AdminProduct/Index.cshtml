@model IEnumerable<Product>

<style>
    /* flexible table where image and actions have fixed width so description uses remaining space */
    table.products-table { width: 100%; table-layout: auto; }

    /* image column fixed; image responsive */
    .img-cell { width: 120px; vertical-align: top; }
    .img-cell img { max-width: 100px; height: auto; display: block; }

    /* allow description to wrap and break long words */
    .desc-cell {
        white-space: normal;
        word-break: break-word;
        vertical-align: top;
    }

    /* keep action buttons side-by-side and compact */
    .action-cell {
        white-space: nowrap;
        width: 140px;
        vertical-align: top;
    }

    .action-cell .btn + .btn {
        margin-left: .35rem;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="m-0">Products</h2>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-lg"></i> Add Product
    </a>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr class="text-center">
            <th>Product ID</th>
            <th>Image</th>
            <th>Product Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>
                    <img src="@item.ImagePath" width="100" height="100" />
                </td>
                <td>@item.Name</td>
                <!-- add class and title for tooltip -->
                <td class="desc-cell" title="@item.Description">@item.Description</td>
                <td>@item.Price</td>
                <td class="action-cell">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning"><i class="bi bi-pencil-square"></i>Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger ms-2"><i class="bi bi-trash"></i>Delete</a>
                </td>
            </tr>

        }
    </tbody>
</table>