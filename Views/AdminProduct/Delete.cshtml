@model Product

<div class="card border-0">
    <div class="card-header ml-0 text-white" style="background-color:darkred">
        <h1 class="p-2 text-center">Delete Product</h1>
    </div>
    <div class="card-body mt-3">
        <h4 class="text-danger text-center mb-4">Are you sure you want to delete this product?</h4>
        <div class="row mb-3">
            <div class="col-md-4 text-center">
                @if(!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath" alt="Product Image" width="250" height="250" class="img-thumbnail"/>
                }
                else
                {
                    <span class="text-muted">No image available</span>
                }
            </div>
            <div class="col-md-8">
            <div class="form-floating mb-3">
                <input asp-for="Name" class="form-control" readonly />
                <label asp-for="Name" class="ms-2 text-muted">Product Name</label>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Description" class="form-control" readonly />
                <label asp-for="Description" class="ms-2 text-muted">Description</label>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Price" class="form-control" readonly />
                <label asp-for="Price" class="ms-2 text-muted">Price</label>
            </div>
            
        </div>
        <form asp-action="DeleteConfirmed" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-center">
                <button type="submit" class="w-50 btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
                <a asp-action="Index" class="w-50 btn btn-secondary ms-2"><i class="bi bi-arrow-left"></i> Back to List</a>
            </div>
        </form>
        </div>
        
        
    </div>