@model IEnumerable<Product>

<h2>Products</h2>
<div class="row pb-3">
    @foreach (var product in Model)
    {
        <div class="col-12 col-sm-6 col-md-4 mb-4">
            <div class="card border-0 p-3 shadow border-top border-5 rounded h-100">
                @if (!string.IsNullOrEmpty(product.ImagePath))
                {
                    <img src="@product.ImagePath" class="card-img-top rounded" style="height: 250px; object-fit: cover;"/>
                }
                else
                {
                    <img src="https://placeholder.co/500x600/png" class="card-img-top rounded"/>
                }
                <div class="card-body">
                    <p class="card-title h5 text-dark text-uppercase text-center">@product.Name</p>
                    <p class="text-muted text-center small">@product.Description</p>
                </div>
                <div class="card-footer bg-white border-0 text-center">
                    <p class="fw-bold fs-5 text-success mb-2">Rs.@product.Price</p>
                    <a asp-action="ProductDetails" asp-route-id="@product.Id" class="btn btn-dark w-100">View Details</a>
                </div>
            </div>
        </div>
    }
</div>

