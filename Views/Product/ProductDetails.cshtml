@model Product

<style>
    html, body {
        overflow-x: hidden;
        margin: 0;
        padding: 0;
    }
    /* Prevent forced vertical scrolling if height isn't needed */
    body {
        overflow-y: auto;
    }
</style>

<div class="container">
    <form method="post" asp-action="ProductDetails" id="addToCartForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ProductId" value="@Model.Id" />

        <div class="row justify-content-center py-4">
            <div class="col-lg-6 col-md-8">
                <div class="card border-0 p-3 shadow border-top border-5 rounded d-flex flex-column">
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <img src="@Model.ImagePath" class="card-img-top rounded" style="height:300px; object-fit:cover;" alt="@Model.Name" />
                    }
                    else
                    {
                        <img src="https://placeholder.co/500x600/png" class="card-img-top rounded" style="height:200px; object-fit:cover;" alt="Placeholder" />
                    }

                    <div class="card-body d-flex flex-column">
                        <div class="text-center">
                            <h3 class="text-uppercase text-dark opacity-75">@Model.Name</h3>
                            <p class="text-muted small mb-2"><strong>@Model.Description</strong></p>
                        </div>

                        <div class="mb-3 px-2 text-center">
                            <h6 class="text-success text-bold text-opacity-20">Price: Rs.@Model.Price</h6>
                        </div>

                        <div class="input-group mb-3 w-50 mx-auto">
                            <span class="input-group-text bg-primary text-white border-0 fw-semibold">Qty</span>
                            <input name="Quantity" type="number" value="1" class="form-control text-end" min="1" />
                        </div>

                        <div class="mt-auto">
                            <button type="submit" class="btn btn-dark w-100 py-2 text-uppercase fw-semibold">Add to Cart</button>
                            <a asp-action="ProductView" class="btn btn-secondary w-100 mt-2">Back to Products List</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>